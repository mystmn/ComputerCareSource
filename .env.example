# ==========================================
# Computer Care Source — FormSubmit.co Config
# ==========================================

# FormSubmit.co destination email or random token
# Replace with the email address where you want to receive booking inquiries:
VITE_FORMSUBMIT_EMAIL=your-email@example.com

# FormSubmit.co will send an activation email on the very first submission.
# Click the confirmation link in that email to activate instant inbox delivery.

# Optional: Secondary webhook (Make, Zapier, Slack, Discord)
VITE_BOOKING_WEBHOOK_URL=
