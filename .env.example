# ==========================================
# Computer Care Source — Form Configuration
# ==========================================

# Web3Forms (https://web3forms.com)
# Enter info@theevergreenstrategy.com on https://web3forms.com to get your free access key:
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# ALTCHA Human Validation (https://altcha.org)
# By default, runs in client-side Proof-of-Work (PoW) mode without requiring any server.
# If you host your own ALTCHA challenge endpoint, set it here:
# VITE_ALTCHA_CHALLENGE_URL=https://api.yourdomain.com/altcha-challenge

# Optional: Secondary webhook (Make, Zapier, Slack, Discord)
VITE_BOOKING_WEBHOOK_URL=
